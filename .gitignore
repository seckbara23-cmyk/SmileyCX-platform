node_modules/
.pnp
.pnp.js

# ── Build output ──────────────────────────────────────────────────────────────
.next/
out/
build/
dist/

# ── Environment variables (NEVER commit secrets) ──────────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ── Vercel ────────────────────────────────────────────────────────────────────
.vercel

# ── TypeScript ────────────────────────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ── OS / Editor artifacts ─────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/settings.json

# ── Debug logs ────────────────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Test coverage ─────────────────────────────────────────────────────────────
coverage/
.nyc_output/

# Supabase CLI local state (project ref, pooler URL, version pins).
# Machine-local link artifacts — never commit.
supabase/.temp/

# ── Media staging ─────────────────────────────────────────────────────────────
# Source video handed over for upload (MEDIA-INTRO-01: seven course
# Introduction films, ~42 MiB). Course media lives in the PRIVATE
# `course-content` Supabase bucket and is delivered by
# /api/media/lesson/<id>/<kind> behind the entitlement check — never from the
# repository and never from public/. Keeping the staging folder out of git is
# what stops a stray `git add -A` turning protected media into a public asset
# and bloating history with binaries that cannot be removed cheaply.
incoming media/
