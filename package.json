{
  "name": "smileycx-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/security/verify-prod-config.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:ci": "vitest run --reporter=verbose",
    "coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "lint:sql": "node scripts/security/check-migrations.mjs",
    "scan:secrets": "node scripts/security/check-secrets.mjs",
    "scan:bundle": "node scripts/security/check-bundle-secrets.mjs",
    "audit:prod": "npm audit --omit=dev --audit-level=critical",
    "verify:prod-config": "node scripts/security/verify-prod-config.mjs",
    "verify": "npm run typecheck && npm run lint && npm run lint:sql && npm run test:ci && npm run scan:secrets && npm run scan:public-assets",
    "scan:public-assets": "node scripts/security/check-public-assets.mjs"
  },
  "dependencies": {
    "@11labs/client": "^0.2.0",
    "@anthropic-ai/sdk": "^0.110.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@react-pdf/renderer": "^4.5.1",
    "@supabase/ssr": "^0.3.0",
    "@supabase/supabase-js": "^2.43.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.378.0",
    "nanoid": "^5.0.7",
    "next": "^14.2.35",
    "pino": "^9.3.2",
    "react": "^18",
    "react-dom": "^18",
    "react-player": "^2.16.0",
    "react-qr-code": "^2.0.21",
    "resend": "^3.4.0",
    "tailwind-merge": "^2.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.45.0",
    "@testing-library/jest-dom": "^6.4.6",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^1.6.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8",
    "eslint-config-next": "14.2.14",
    "eslint-plugin-jsx-a11y": "^6.9.0",
    "jsdom": "^24.1.1",
    "pino-pretty": "^11.2.1",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "typescript": "^5",
    "vitest": "^1.6.0"
  }
}
