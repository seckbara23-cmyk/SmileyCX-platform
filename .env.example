# ══════════════════════════════════════════════════════════════════════════════
# XP Client Academy Platform — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.
# ══════════════════════════════════════════════════════════════════════════════

# ── Supabase (required) ───────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API

# Public URL of your Supabase project (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase anon key — public, restricted by Row Level Security policies
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase service role key — SECRET, server-only, bypasses RLS
# Used only in lib/supabase/admin.ts for trusted server-side operations
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── App URL (required for auth callbacks) ─────────────────────────────────────
# In development: http://localhost:3000
# In production:  https://your-app.vercel.app  (or your custom domain)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Platform Mode (required) ──────────────────────────────────────────────────
# Controls overall platform access level.
#   pilot   — open pilot: anonymous access to content, free enrollment active (DEFAULT)
#   private — pre-launch lockdown: only emails listed in lib/access-control.ts
#             (ALLOWED_PRIVATE_EMAILS) can access protected routes. Unauthenticated
#             users are redirected to /login; authenticated non-allowlisted users
#             are redirected to /access-restricted. Signup disabled, enrollment
#             paused, waitlist CTA shown to visitors.
#   public  — production: auth + payments required, signup open
#
# To restrict access: set to 'private' and edit ALLOWED_PRIVATE_EMAILS in
# lib/access-control.ts. To open to the public: switch to 'public'.
NEXT_PUBLIC_PLATFORM_MODE=pilot

# ── Admin credentials (required for /admin/login) ────────────────────────────
# ADMIN_USERNAME: the username shown on the admin login form (e.g. "Admin")
# ADMIN_EMAIL:    the Supabase account email of the admin user
# The admin Supabase account must have platform_role = 'super_admin' in profiles.
ADMIN_USERNAME=Admin
ADMIN_EMAIL=admin@example.com

# ── Email — Resend (optional for pilot, required for production) ─────────────
# Get your API key at https://resend.com
# Set EMAIL_DRY_RUN=true to log emails to console instead of sending (dev/CI).
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=XP Client Academy <noreply@your-verified-domain.com>
EMAIL_DRY_RUN=true

# ── Logging ───────────────────────────────────────────────────────────────────
# Log level: trace | debug | info | warn | error | fatal
# Defaults to "debug" in development, "info" in production.
LOG_LEVEL=debug

# ── AI Practice Engine — Voice Practice (Phase 1) ────────────────────────────
# Global kill-switch for the Voice Practice UI. Default OFF: when unset/false,
# the lesson player makes no AI queries and shows no Voice Practice surface.
# Enable only after migration 024 is applied AND a scenario is published.
NEXT_PUBLIC_AI_VOICE_ENABLED=false
# AI Coach (Phase 2A) — deterministic briefing + competency engine + replay.
# Default OFF: when unset/false, Voice Practice behaves exactly like Phase 1B.
# Enable only after migration 025 is applied. No LLM is used in Phase 2A.
NEXT_PUBLIC_AI_COACH_ENABLED=false
# AI Coach — Claude evaluation (Phase 2B). Default OFF. When false, no
# Claude/Anthropic call is ever made. Requires the coach flag on, migration 026
# applied, and ANTHROPIC_API_KEY set. Claude runs at most once per session.
NEXT_PUBLIC_AI_COACH_CLAUDE_ENABLED=false
# Anthropic API key — SECRET, server-only (never prefix NEXT_PUBLIC). Used only
# for the one-shot coaching evaluation. Without it the coach falls back to the
# deterministic report.
ANTHROPIC_API_KEY=
# Optional model override for the coach (default: claude-opus-4-8). Set e.g.
# claude-sonnet-5 for a lower-cost tier.
ANTHROPIC_MODEL=
# ElevenLabs Conversational AI — SECRET, server-only (never prefix NEXT_PUBLIC).
# Exchanged server-side for a short-lived signed URL to run the live voice loop.
# Required for live Voice Practice; without it the block falls back to the
# deterministic self-assessment. The per-scenario agent id is stored in
# ai_scenarios.agent_id (DB), never in env and never sent to the browser.
ELEVENLABS_API_KEY=

# ── Payment gateways (optional — leave blank during pilot) ───────────────────
# These are intentionally unused while NEXT_PUBLIC_FREE_ACCESS_MODE=true.
# Configure when payments are activated post-pilot.
ORANGE_MONEY_API_KEY=
ORANGE_MONEY_MERCHANT_ID=
WAVE_API_KEY=
WAVE_MERCHANT_ID=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Administration portal (CX-AUTH-1) ─────────────────────────────────
# Comma-separated allowlist of authorized administrator addresses.
# Every listed address has identical, full administration access — this is an
# allowlist, not a role model. Compared case-insensitively; whitespace trimmed.
# Server-side only — no NEXT_PUBLIC_ prefix, so it never reaches the client
# bundle. If missing or empty, NO ONE is authorized (fails closed).
ADMIN_OWNER_EMAILS=owner@example.com,second-admin@example.com

# Hostnames served as the PRIVATE administration portal (comma-separated).
# Optional — defaults to smiley-cx-platform.vercel.app. Add
# admin.xpclient-academy.com here later with no code change.
ADMIN_HOSTS=smiley-cx-platform.vercel.app

# Canonical PUBLIC site URL (used for certificate links and metadata).
NEXT_PUBLIC_SITE_URL=https://www.xpclient-academy.com

# ── Admin password rotation (CX-AUTH-1A, one-time maintenance) ────────
# Used ONLY by scripts/change-admin-passwords.mjs. Leave BLANK in the
# repository — never commit real passwords. Set them inline when running
# the script, or fill them in .env.local (which is gitignored).
SECKBARA_NEW_PASSWORD=
MARIEME_NEW_PASSWORD=

# ── Public brand & domain (XPA-1) ──────────────────────────────────────
# Canonical PUBLIC academy origin. Drives metadata, Open Graph, canonical
# links, sitemap, certificate verification URLs and email links.
# Leave unset to use the built-in canonical domain.
# NOTE: the legacy NEXT_PUBLIC_APP_URL is NOT used for this any more.
NEXT_PUBLIC_SITE_URL=https://www.xpclient-academy.com

# Public contact address shown in the UI (footer, contact, terms, checkout).
# Must be NEXT_PUBLIC_ so the client Footer and the server agree.
NEXT_PUBLIC_CONTACT_EMAIL=

# ══════════════════════════════════════════════════════════════════════════
# PAYMENT PROVIDERS — server-only. PLACEHOLDERS ONLY; never commit a real key.
# ══════════════════════════════════════════════════════════════════════════
#
# None of these may be NEXT_PUBLIC_. A payment credential in the client bundle
# is a credential published to the world, and `scan:bundle` fails the build if
# one appears there.

# ── PayDunya (PAY-LAUNCH-02A) ──────────────────────────────────────────────
# Exactly 'test' or 'live'. No default: absent or misspelled fails closed.
# The three credentials are read from the SELECTED mode only, so test and live
# cannot cross.
PAYDUNYA_MODE=
PAYDUNYA_TEST_MASTER_KEY=
PAYDUNYA_TEST_PRIVATE_KEY=
PAYDUNYA_TEST_TOKEN=
PAYDUNYA_LIVE_MASTER_KEY=
PAYDUNYA_LIVE_PRIVATE_KEY=
PAYDUNYA_LIVE_TOKEN=

# ── PayTech (XP-PAYTECH-01) ────────────────────────────────────────────────
# Exactly 'test' or 'prod' — PayTech's own `env` vocabulary. These map onto the
# 'test' | 'live' values payments.provider_mode accepts; the mapping lives in
# lib/payments/paytech-config.ts and nowhere else.
#
# Find the key and secret in the PayTech merchant dashboard under
# Settings -> API. They are sent as the API_KEY and API_SECRET request headers.
PAYTECH_MODE=
PAYTECH_TEST_API_KEY=
PAYTECH_TEST_API_SECRET=
PAYTECH_PROD_API_KEY=
PAYTECH_PROD_API_SECRET=

# Offer PayTech at checkout. Must be exactly 'true'; anything else is off.
PAYTECH_ENABLED=

# A SECOND, separate approval required before PayTech is offered in production
# (VERCEL_ENV=production). Must be exactly 'true'. Enabling PAYTECH_ENABLED
# everywhere is deliberately NOT enough to enable it in production, so a
# preview flag cannot become a production fulfilment path.
PAYTECH_ALLOW_PRODUCTION=

# ══════════════════════════════════════════════════════════════════════════
# LOCAL UAT (XP-SEC-03) — copy these into `.env.uat.local`, which is gitignored
# ══════════════════════════════════════════════════════════════════════════
#
# Fill from `npx supabase status` AFTER `npx supabase start`. Never copy values
# from the production `.env.local`: `npm run verify:uat-isolation` reads the
# project ref out of the URL AND out of both keys, and refuses the run if any
# of them names production — or any other hosted project, beside a local URL.
#
# These live here rather than in a separate `.env.uat.example` because
# `scan:secrets` forbids every committed env file except this one, and that
# rule is worth more than the convenience of a second template.

# local Supabase stack (from `supabase status`)
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# outbound email OFF — the gate refuses a real key unless dry-run is on
# EMAIL_DRY_RUN=true

# billable AI OFF — the gate refuses a key whose feature flag is still true
# NEXT_PUBLIC_AI_COACH_ENABLED=false
# NEXT_PUBLIC_AI_COACH_CLAUDE_ENABLED=false
# NEXT_PUBLIC_AI_VOICE_ENABLED=false

# payments: sandbox only. PAYTECH_MODE=prod, any PAYTECH_PROD_*,
# PAYTECH_ALLOW_PRODUCTION=true and PAYDUNYA_MODE=live are each a refusal.
# PAYTECH_MODE=test
# PAYTECH_ENABLED=false
