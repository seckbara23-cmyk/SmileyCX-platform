# ══════════════════════════════════════════════════════════════════════════════
# XP Client Academy Platform — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.
# ══════════════════════════════════════════════════════════════════════════════

# ── Supabase (required) ───────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API

# Public URL of your Supabase project (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase anon key — public, restricted by Row Level Security policies
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase service role key — SECRET, server-only, bypasses RLS
# Used only in lib/supabase/admin.ts for trusted server-side operations
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── App URL (required for auth callbacks) ─────────────────────────────────────
# In development: http://localhost:3000
# In production:  https://your-app.vercel.app  (or your custom domain)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Pilot Mode (required) ─────────────────────────────────────────────────────
# Set to "true" to enable free enrollment — payment UI is bypassed entirely.
# Set to "false" (or remove) when real payment gateways are configured.
NEXT_PUBLIC_FREE_ACCESS_MODE=true

# ── Admin credentials (required for /admin/login) ────────────────────────────
# ADMIN_USERNAME: the username shown on the admin login form (e.g. "Admin")
# ADMIN_EMAIL:    the Supabase account email of the admin user
# The admin Supabase account must have platform_role = 'super_admin' in profiles.
ADMIN_USERNAME=Admin
ADMIN_EMAIL=admin@example.com

# ── Email — Resend (optional for pilot, required for production) ─────────────
# Get your API key at https://resend.com
# Set EMAIL_DRY_RUN=true to log emails to console instead of sending (dev/CI).
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=XP Client Academy <noreply@your-verified-domain.com>
EMAIL_DRY_RUN=true

# ── Logging ───────────────────────────────────────────────────────────────────
# Log level: trace | debug | info | warn | error | fatal
# Defaults to "debug" in development, "info" in production.
LOG_LEVEL=debug

# ── Payment gateways (optional — leave blank during pilot) ───────────────────
# These are intentionally unused while NEXT_PUBLIC_FREE_ACCESS_MODE=true.
# Configure when payments are activated post-pilot.
ORANGE_MONEY_API_KEY=
ORANGE_MONEY_MERCHANT_ID=
WAVE_API_KEY=
WAVE_MERCHANT_ID=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
