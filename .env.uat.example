# XP Client Academy — LOCAL UAT environment template (XP-SEC-03)
#
# Copy to `.env.uat.local` (gitignored) and fill from `supabase status` AFTER
# `supabase start`. Never copy values from the production `.env.local`:
# `npm run verify:uat-isolation` reads the project ref out of the URL *and*
# out of both keys, and refuses the run if any of them names production.
#
# PLACEHOLDERS ONLY. Never commit real values.

# ── local Supabase stack (from `supabase status`) ─────────────────────────
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key printed by `supabase status`>
SUPABASE_SERVICE_ROLE_KEY=<service_role key printed by `supabase status`>

# ── outbound email: OFF ───────────────────────────────────────────────────
# The local stack captures mail in its own SMTP viewer (port 54324), but the
# gate still refuses a real Resend key unless dry-run is explicitly on.
EMAIL_DRY_RUN=true
RESEND_API_KEY=

# ── billable AI integrations: OFF ─────────────────────────────────────────
# The gate refuses a key whose feature flag is still 'true'.
NEXT_PUBLIC_AI_COACH_ENABLED=false
NEXT_PUBLIC_AI_COACH_CLAUDE_ENABLED=false
NEXT_PUBLIC_AI_VOICE_ENABLED=false
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=

# ── payments: sandbox only, never live ────────────────────────────────────
# PAYTECH_MODE=prod, any PAYTECH_PROD_*, PAYTECH_ALLOW_PRODUCTION=true and
# PAYDUNYA_MODE=live are each an outright refusal.
PAYTECH_MODE=test
PAYTECH_TEST_API_KEY=
PAYTECH_TEST_API_SECRET=
PAYTECH_ENABLED=false
PAYTECH_ALLOW_PRODUCTION=

# ── platform ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_PLATFORM_MODE=pilot
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
